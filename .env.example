# EmailJS credentials for the contact form (src/hooks/useContactForm.ts).
#
# These are inlined at BUILD time by Vite, so they must be present in the
# build environment — not just at runtime. If any one is missing the form
# fails closed: the visitor sees "Something went wrong" and the lead is lost
# silently. Set all three wherever you build for production.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
